# =============================================================================
# AgentForge MCP & Provider Configuration
# =============================================================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentforge_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentforge_db

# LLM Provider
GROQ_API_KEY=your_groq_api_key


# 1. Context7 (Library Documentation)
CONTEXT7_API_KEY=your_context7_api_key
CONTEXT7_MCP_URL=https://mcp.context7.com/mcp

# 2. DuckDuckGo Search
DUCKDUCKGO_MCP_COMMAND=uvx
DUCKDUCKGO_MCP_PACKAGE=duckduckgo-mcp-server

# 3. Google Drive
GOOGLE_DRIVE_MCP_URL=https://drivemcp.googleapis.com/mcp/v1
GOOGLE_DRIVE_ACCESS_TOKEN=your_google_drive_access_token
GOOGLE_DRIVE_CREDENTIALS_PATH=/absolute/path/to/credentials.json
GOOGLE_DRIVE_TOKEN_PATH=/absolute/path/to/token.json

# 4. Notion Hosted MCP
NOTION_MCP_URL=https://mcp.notion.com/mcp
NOTION_ACCESS_TOKEN=your_notion_access_token

# 5. Filesystem
FILESYSTEM_MCP_COMMAND=npx
FILESYSTEM_ALLOWED_DIR=/absolute/path/to/allowed/directory

# 6. Git
GIT_MCP_COMMAND=uvx
GIT_REPOSITORY_PATH=/absolute/path/to/git/repository

# 7. Sequential Thinking
SEQUENTIAL_THINKING_MCP_COMMAND=npx
